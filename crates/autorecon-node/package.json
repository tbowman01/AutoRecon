{
  "name": "@autorecon/core",
  "version": "1.0.0",
  "description": "Native Node.js bindings for AutoRecon network reconnaissance",
  "main": "index.js",
  "types": "index.d.ts",
  "author": "Tib3rius",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tib3rius/AutoRecon.git"
  },
  "keywords": [
    "security",
    "reconnaissance",
    "pentesting",
    "nmap",
    "network-scanning",
    "oscp",
    "native",
    "rust",
    "napi"
  ],
  "napi": {
    "name": "autorecon",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "artifacts": "napi artifacts",
    "version": "napi version",
    "test": "node test/basic.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "publishConfig": {
    "access": "public"
  }
}
